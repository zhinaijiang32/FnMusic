# Host port exposed by Docker. The service still listens on 8443 inside Docker.
FNMUSIC_PORT=8443

# Persistent service state: SQLite database, self-signed certificate, and JWT secret.
FNMUSIC_DATA_DIR=./data

# Music cache directory on the Docker host. It can be an absolute NAS path.
# Example: /volume1/media/fnmusic-cache
MUSIC_CACHE_DIR=./data/music

# Optional: NAS IP or hostname for the self-signed certificate.
INTERNAL_HOST=localhost
