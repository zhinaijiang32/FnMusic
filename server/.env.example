# 飞牛音乐服务端 - 环境配置
# Docker host port.
FNMUSIC_PORT=8443

# Database, TLS certificate, and persistent session-signing state.
FNMUSIC_DATA_DIR=./data

# Host/NAS directory for downloaded music cache.
# Example: /volume1/media/fnmusic-cache
MUSIC_CACHE_DIR=./data/music

# Optional: NAS IP or hostname for the self-signed certificate.
INTERNAL_HOST=localhost
